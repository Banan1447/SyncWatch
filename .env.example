# =============================================================================
# WATCHSYNC PLATFORM — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
# Your server's external IP address (for TURN server WebRTC NAT traversal)
# Find: ipconfig (Windows) / ip addr (Linux)
EXTERNAL_IP=192.168.1.100

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_USER=watchsync
DB_PASSWORD=your_secure_password_here
DB_NAME=watchsync

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO (S3-compatible video storage)
# -----------------------------------------------------------------------------
MINIO_USER=minioadmin
MINIO_PASSWORD=your_minio_password

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT secret — must be at least 32 chars, keep secret!
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_this

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# YouTube Data API v3 key (optional — enables YouTube video metadata)
YOUTUBE_API_KEY=

# LM Studio (optional — local LLM for MCP tools)
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=mistralai/ministral-3-3b

# -----------------------------------------------------------------------------
# Monitoring & Alerting
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password

# SMTP for email verification (optional — leave SMTP_HOST empty to disable)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@watchsync.local
FRONTEND_URL=http://localhost
# Block login if email unverified after N days (0 = disabled)
EMAIL_VERIFY_TIMEOUT_DAYS=0

# Telegram Alerting (optional — leave empty to disable)
# 1. Create a bot via @BotFather → get TELEGRAM_BOT_TOKEN
# 2. Add bot to a group/channel → get TELEGRAM_CHAT_ID (negative for groups, e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# =============================================================================
# Port reference:
#   8080    — Frontend HTTP (React, via NGINX)
#   8443    — Frontend HTTPS (React, via NGINX)
#   3001    — Grafana
#   3100    — Loki
#   3333    — MCP Server
#   3478    — TURN (Coturn)
#   4222    — NATS
#   5432    — PostgreSQL
#   6379    — Redis
#   8000    — Kong API Gateway (REST API)
#   8001    — Kong Admin
#   8081    — Auth Service
#   8082    — User Service
#   8083    — Room Service
#   8084    — Video Service
#   8085    — WS Gateway (WebSocket /ws)
#   8086    — Sync Service
#   8087    — Chat Service
#   8088    — Media Server / SFU (mediasoup)
#   8089    — Parser Service
#   8191    — FlareSolverr
#   9000    — MinIO S3 API
#   9001    — MinIO Console
#   9042    — ScyllaDB CQL
#   9090    — Prometheus
#   9093    — Alertmanager
#   9100    — Node Exporter
#   9121    — Redis Exporter
#   9187    — PostgreSQL Exporter
#   16686   — Jaeger UI
#   40000-40099 — Media RTC UDP ports
# =============================================================================

# Let's Encrypt (DNS-01 via reg.ru) — issue + auto-renew
# REGRU_USERNAME / REGRU_PASSWORD = reg.ru account API credentials.
LE_DOMAIN=watch.anyass.ru
LE_EMAIL=you@example.com
REGRU_USERNAME=
REGRU_PASSWORD=
